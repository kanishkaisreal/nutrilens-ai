# Keep DEMO_MODE=true to run the app without an API key.
DEMO_MODE=true

# Never commit your OPENAI_API_KEY. Store real keys only in a local .env file.
OPENAI_API_KEY=

# Model names are configurable and can be changed by users.
OPENAI_GUARDRAIL_MODEL=gpt-5-mini
OPENAI_MEAL_MODEL=gpt-5-mini
OPENAI_SAFETY_MODEL=gpt-5-nano
