# The demo provider works without an API key.
DEMO_MODE=true
MODEL_PROVIDER=demo

# Allowed providers: demo, openai, qwen.
# qwen is optional and requires requirements-qwen.txt.
# Local Qwen inference may require significant memory and a large model download.
# Demo remains the default and never makes a model request.

# The openai provider requires DEMO_MODE=false and OPENAI_API_KEY.
# Never commit a real key. Store it only in a local .env file.
OPENAI_API_KEY=

# Model names are configurable and can be changed by users.
OPENAI_GUARDRAIL_MODEL=gpt-5-mini
OPENAI_MEAL_MODEL=gpt-5-mini
OPENAI_SAFETY_MODEL=gpt-5-mini

# Optional Qwen provider scaffold. Local inference is disabled by default.
QWEN_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
QWEN_ALLOW_LOCAL_INFERENCE=false
QWEN_DEVICE=auto
